{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Source keeps the repo's `.ts` import convention (Bun's, and what
    // everything in ../../src does). TypeScript 5.7 rewrites those to `.js` on
    // emit, so the published package is valid ESM without the source having to
    // lie about which file it is importing.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*.ts"]
}
